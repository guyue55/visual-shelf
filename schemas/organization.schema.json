{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visual Shelf organization registry",
  "description": "编辑辅助；跨记录引用和归属一致性由运行时校验器校验。",
  "type": "object",
  "required": [
    "version",
    "owners",
    "series",
    "components"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(shared|unknown|(project|product):[a-z0-9]+(?:-[a-z0-9]+)*)$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "owner"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "accent": {
            "enum": [
              "night",
              "clay",
              "sage",
              "sand"
            ]
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
