{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visual Shelf asset",
  "type": "object",
  "required": [
    "id",
    "name",
    "kind",
    "path",
    "tags",
    "source",
    "license",
    "author",
    "created",
    "description",
    "sha256"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "enum": [
        "logos",
        "icons",
        "legends",
        "covers"
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created": {
      "type": "string",
      "format": "date"
    }
  }
}
