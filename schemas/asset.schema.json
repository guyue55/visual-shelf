{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visual Shelf asset",
  "type": "object",
  "required": [
    "id",
    "name",
    "kind",
    "path",
    "tags",
    "source",
    "license",
    "author",
    "created",
    "description",
    "sha256"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "enum": [
        "logos",
        "icons",
        "legends",
        "covers"
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "approval": {
      "type": "object",
      "description": "确认绑定当前文件哈希；历史记录可无此字段",
      "required": [
        "user_confirmation",
        "reviewed_sha256"
      ],
      "properties": {
        "user_confirmation": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task": {
          "type": "string"
        },
        "checks": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "template": {
          "type": "string"
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": "string"
        }
      }
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "description": "引用 organization.json owners.id"
        },
        "series": {
          "type": [
            "string",
            "null"
          ]
        },
        "component": {
          "type": [
            "string",
            "null"
          ]
        },
        "functions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "platforms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
